# AWS credentials for GitHub Actions / manual deployments
# Copy this file to .env.production and fill in your values.
# NEVER commit the actual .env.production file.

AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=us-east-1

# S3 bucket that hosts the frontend build
S3_BUCKET=springboard-talent-frontend

# CloudFront distribution ID (from `terraform output cloudfront_distribution_id`)
CLOUDFRONT_DISTRIBUTION_ID=E123ABCDEF456

# CloudFront public domain (from `terraform output cloudfront_domain_name`)
CLOUDFRONT_DOMAIN=d1234567890abc.cloudfront.net

# Frontend environment
REACT_APP_API_BASE_URL=https://api.springboard-talent.com/api/v1
REACT_APP_ENV=production

# Custom domain (optional — used when Route53 is configured)
DOMAIN_NAME=springboard-talent.com
API_DOMAIN=api.springboard-talent.com
